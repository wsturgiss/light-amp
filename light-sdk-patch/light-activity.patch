+    /**
+     * SDK PATCH (additive, upstreamable): unwind to the initial screen, keeping
+     * the same teardown order [goBack] uses for each popped entry. Needed by
+     * tools whose bottom navigation is visible on nested screens.
+     *
+     * [currentScreen] is published **once**, at the end. Assigning it inside the
+     * loop made every screen on the way down the current one for a frame, and
+     * since it drives composition each of them was drawn on its way out — so
+     * unwinding four screens flashed four pages past the user before the root
+     * appeared, and how many depended on how deep the stack happened to be. They
+     * are all being destroyed; none of them needs to be shown to do it.
+     */
+    internal fun popToRoot() {
+        if (backStack.size <= 1) {
+            backStack.lastOrNull()?.screen?.notifyWillShow()
+            return
+        }
+        while (backStack.size > 1) {
+            val entry = backStack.last()
+            entry.screen.notifyWillHide()
+            entry.screen.destroy()
+            entry.viewModelStoreOwner.viewModelStore.clear()
+            backStack.removeAt(backStack.lastIndex)
+        }
+        currentScreen.value = backStack.last()
+        backStack.last().screen.notifyWillShow()
+    }
